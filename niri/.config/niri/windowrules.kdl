// Window styling, named app workspaces, and per-app placement.

// Draw the focus ring / border *around* windows instead of as a solid
// rectangle behind them. Without this, the focus-ring background bleeds
// through semi-transparent windows (e.g. foot with alpha < 1).
window-rule {
    draw-border-with-background false
}

// Named workspaces on the main display (eDP-1), in order. The four leading
// general workspaces push the app workspaces to indices 5/6:
//   1-4 = general          (Mod+1..Mod+4, default index binds)
workspace "1" { open-on-output "eDP-1"; }
workspace "2" { open-on-output "eDP-1"; }
workspace "3" { open-on-output "eDP-1"; }
workspace "4" { open-on-output "eDP-1"; }

// Per-app placement (case-insensitive: Slack reports app-id "Slack").
// open-maximized fills the workspace instead of the default half width.
window-rule {
    match app-id=r#"(?i)^slack$"#
    open-on-workspace "2"
    open-maximized true
}

window-rule {
    match app-id=r#"(?i)^discord$"#
    open-on-workspace "3"
    open-maximized true
}

// Slightly dim inactive windows.
window-rule {
    match is-active=false
    opacity 0.9
}
