// Custom keybinds: Noctalia shell IPC, app launchers, and named app workspaces.
// Included AFTER the main `binds` block in config.kdl, so these override niri's
// defaults for duplicate keys (niri merges binds across includes; later wins).
//
// General workspaces 1-4 use the default Mod+1..Mod+4 (index) binds.
// App workspaces are reached by letter:
//   Mod+C -> chat (Slack, index 5)   Mod+D -> discord (6)
//   Mod+Shift+<letter> moves the focused window to that workspace.
//
// Noctalia 5 is a single binary; IPC is invoked via: noctalia msg <command> [args]
binds {
    // --- Noctalia shell ---
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher";
    }
    Mod+V hotkey-overlay-title="Clipboard History" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard";
    }
    Mod+N hotkey-overlay-title="Notification Center" {
        spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn "noctalia" "msg" "settings-toggle";
    }
    Mod+Y hotkey-overlay-title="Wallpaper Selector" {
        spawn "noctalia" "msg" "panel-toggle" "wallpaper";
    }
    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn "noctalia" "msg" "session" "lock";
    }

    // --- App launchers ---
    Mod+B hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Mod+E hotkey-overlay-title="File Manager" { spawn "thunar"; }

    // --- Window actions ---
    Mod+Shift+Space { toggle-window-floating; }   // float / unfloat the focused window

    // --- Focus app workspaces ---
    // (music workspace is index 7 -> reach it with Mod+7; move there with Mod+Ctrl+7)
    Mod+C { focus-workspace "2"; }
    Mod+D { focus-workspace "3"; }

    // --- Move focused window to an app workspace ---
    Mod+Shift+C { move-column-to-workspace "chat"; }
    Mod+Shift+D { move-column-to-workspace "discord"; }

    // --- Screenshots ---
    Mod+S { screenshot; }               // interactive: select a region or window
    Mod+Shift+S { screenshot-screen; }  // capture the whole screen
}
